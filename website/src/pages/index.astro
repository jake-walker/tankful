---
import { Image } from "astro:assets";
import Layout from "../layouts/main.astro";
import AppIcon from "../../public/app-icon.png";
import ScreenshotHome from "../../../scripts/screenshots/ios/01-overview.png";
import ScreenshotLogs from "../../../scripts/screenshots/ios/02-logs.png";
import ScreenshotAddLog from "../../../scripts/screenshots/ios/03-add-log.png";
import AndroidScreenshotHome from "../../../scripts/screenshots/android/01-overview.png";
import AndroidScreenshotLogs from "../../../scripts/screenshots/android/02-logs.png";
import AndroidScreenshotAddLog from "../../../scripts/screenshots/android/03-add-log.png";

const galleries = [
  {
    platform: "ios",
    name: "iOS",
    screenshots: [
      { label: "Fuel log", src: ScreenshotHome },
      { label: "Add a fill-up", src: ScreenshotAddLog },
      { label: "View fill-up history", src: ScreenshotLogs },
    ],
  },
  {
    platform: "android",
    name: "Android",
    screenshots: [
      { label: "Fuel log", src: AndroidScreenshotHome },
      { label: "Add a fill-up", src: AndroidScreenshotAddLog },
      { label: "View fill-up history", src: AndroidScreenshotLogs },
    ],
  },
];
---

<Layout title="Tankful - Fuel logging for iOS and Android">
  <main class="mx-auto w-full max-w-3xl px-6 py-10 sm:py-16">
    <header class="flex items-center gap-4">
      <div
        class="flex size-16 shrink-0 items-center justify-center rounded-2xl"
        aria-hidden="true"
      >
        <Image src={AppIcon} alt="Tankful App Icon" />
      </div>
      <div>
        <h1 class="text-3xl font-semibold">Tankful</h1>
        <p class="mt-1 text-sm text-muted">
          Fuel logging for iOS and Android · Beta
        </p>
      </div>
    </header>

    <div class="mt-7 space-y-4 leading-relaxed">
      <p>
        A simple app for logging your fill-ups. It works offline and keeps your
        fuel logs on your device.
      </p>
      <p>
        Optionally sync with your own Tracktor or LubeLogger instance. You
        choose the server and stay in control of your data.
      </p>
      <p>
        <a
          href="/ios-beta"
          class="font-medium underline decoration-brand decoration-2 underline-offset-4 me-6 hover:no-underline"
        >
          Join the iOS beta →
        </a>

        <a
          href="/android-beta"
          class="font-medium underline decoration-brand decoration-2 underline-offset-4 hover:no-underline"
        >
          Join the Android beta →
        </a>
      </p>
    </div>

    <section class="mt-8" aria-label="App screenshots">
      <input class="sr-only" type="radio" name="screenshot-platform" id="screenshots-ios" checked />
      <input class="sr-only" type="radio" name="screenshot-platform" id="screenshots-android" />
      <script is:inline>
        const initialPlatform = /Android/i.test(navigator.userAgent) ? "android" : "ios";
        document.getElementById(`screenshots-${initialPlatform}`).checked = true;
      </script>

      <div class="platform-switch mb-6 flex justify-center" aria-label="Screenshot platform">
        <div class="inline-flex rounded-full border border-ink/20 p-1 text-sm font-medium">
          <label for="screenshots-ios" class="cursor-pointer rounded-full px-4 py-2 text-ink">iOS</label>
          <label for="screenshots-android" class="cursor-pointer rounded-full px-4 py-2 text-ink">Android</label>
        </div>
      </div>

      {galleries.map(({ platform, name, screenshots }) => (
        <div class={`gallery-${platform}`}>
          <div class="grid grid-cols-1 justify-items-center gap-6 sm:grid-cols-3 sm:justify-items-start">
            {screenshots.map(({ label, src }) => (
              <figure class="w-full max-w-60">
                <Image
                  src={src}
                  alt={`${name} ${label.toLowerCase()}`}
                  width="390"
                  loading="lazy"
                  class="h-auto w-full rounded-4xl"
                />
                <figcaption class="mt-2 text-center text-sm text-muted">
                  {label}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      ))}
    </section>
  </main>
</Layout>

<style>
  #screenshots-ios:checked ~ .gallery-android,
  #screenshots-android:checked ~ .gallery-ios {
    display: none;
  }

  #screenshots-ios:checked ~ .platform-switch label[for="screenshots-ios"],
  #screenshots-android:checked ~ .platform-switch label[for="screenshots-android"] {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  #screenshots-ios:focus-visible ~ .platform-switch label[for="screenshots-ios"],
  #screenshots-android:focus-visible ~ .platform-switch label[for="screenshots-android"] {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
</style>
