---
import Layout from "./main.astro";

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} - Tankful`}>
  <main class="container mx-auto my-8">
    <a
      href="/"
      class="text-sm font-medium text-muted underline decoration-brand/60 underline-offset-4 hover:text-ink"
      >← Back to home</a
    >
    <h1 class="mt-8 text-4xl font-bold tracking-tight sm:text-5xl">
      {frontmatter.title}
    </h1>
    <div
      class="mt-10 space-y-8 text-base leading-relaxed text-muted prose dark:prose-invert max-w-none"
    >
      <slot />
    </div>
  </main>
</Layout>
