---
import "../styles/main.css";
interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Tankful - Fuel logging, made simple.",
  description = "An easier way to log fuel on iOS and Android. Works offline, with optional sync to your own Tracktor or LubeLogger instance.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta
      name="theme-color"
      content="#fffaf5"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#1c1917"
      media="(prefers-color-scheme: dark)"
    />
    <title>{title}</title>
  </head>
  <body class="flex min-h-screen flex-col bg-cream text-ink antialiased">
    <slot />
    <footer
      class="mx-auto mt-auto flex w-full max-w-4xl items-center justify-between gap-4 border-t border-ink/10 px-6 py-7 text-sm text-muted"
    >
      <a href="/" class="font-semibold text-ink">Tankful</a>
      <nav aria-label="Footer" class="flex flex-wrap gap-x-5 gap-y-2">
        <a
          href="https://github.com/jake-walker/tankful"
          class="underline decoration-brand/60 underline-offset-4 hover:text-ink"
          >GitHub</a
        >
        <a
          href="/privacy"
          class="underline decoration-brand/60 underline-offset-4 hover:text-ink"
          >Privacy Policy</a
        >
      </nav>
    </footer>
  </body>
</html>
